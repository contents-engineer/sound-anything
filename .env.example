# Which provider to use: mock | openai | anthropic | gemini
AI_PROVIDER=mock

# Fill only the provider you're using.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Gemini는 서버에 키를 두지 않습니다 — 화면 우측 상단에서 사용자가 직접
# Google AI Studio 키(https://aistudio.google.com/apikey)를 등록합니다.
# 무료 티어 키(결제 미연결 프로젝트)도 그대로 동작합니다.
GEMINI_MODEL=gemini-3.1-flash-lite
